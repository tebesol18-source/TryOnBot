# --- Secrets / environment (never commit real credentials) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json
token*

# --- Customer data & generated media (privacy: never commit) ---
data/**
!data/.gitkeep
media/
previews/
downloads/
*.jpg
*.jpeg
*.png
*.webp

# --- Local databases ---
*.db
*.sqlite
*.sqlite3

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- IDE / OS noise ---
.idea/
.vscode/
*.swp
