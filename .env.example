# Faith-EL Virtual Stylist — environment template
# Copy to .env and fill in values locally. NEVER commit the real .env file.
# This template contains NO real secrets.

# Telegram bot token obtained from @BotFather.
# Left EMPTY on purpose. The application must refuse to start the Telegram
# layer until a valid token is provided by the operator via a local .env file.
BOT_TOKEN=

# Optional: path overrides (defaults shown are relative to project root)
# FAITH_EL_CONFIG_DIR=config
# FAITH_EL_DATA_DIR=data

# Optional: runtime mode. "development" enables verbose logging.
# FAITH_EL_ENV=development
